generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserCapability {
  TELEGRAM_TRANSACTIONS
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RefreshTokenRevokeReason {
  LOGOUT
  PASSWORD_RESET
  USER_DEACTIVATED
  ADMINISTRATIVE_ACTION
  SECURITY_EVENT
}

enum ChallengePurpose {
  PASSWORD_RESET
  ACCOUNT_REACTIVATION
  EMAIL_VERIFICATION
  MESSAGING_IDENTITY_VERIFICATION
}

enum ChallengeSubjectType {
  USER
  MESSAGING_IDENTITY
  EMAIL
}

enum ChallengeStatus {
  REQUESTED
  COMPLETED
  FAILED
  EXPIRED
}

enum StorageContextType {
  USER_PROFILE
  GROUP_COVER
  TRANSACTION_ATTACHMENT
  RECEIPT
}

enum StorageStatus {
  PROCESSING
  UPLOADING
  COMPLETED
  FAILED
}

enum StorageProvider {
  CLOUDFLARE_R2
}

enum MessagingProvider {
  TELEGRAM
}

enum MessagingIdentityStatus {
  PENDING_VERIFICATION
  VERIFIED
  REVOKED
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  username              String                 @unique
  name                  String
  email                 String                 @unique
  phone                 String
  role                  UserRole               @default(USER)
  passwordHash          String                 @map("password_hash")
  capabilities          UserCapability[]       @default([])
  status                UserStatus             @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  inactivatedAt         DateTime?              @map("inactivated_at")
  refreshTokens         RefreshToken[]
  storedFiles           StoredFile[]
  messagingIdentities   MessagingIdentity[]

  @@index([status, inactivatedAt])
  @@map("users")
}

model RefreshToken {
  id           String                    @id @default(uuid()) @db.Uuid
  userId       String                    @map("user_id") @db.Uuid
  tokenHash    String                    @unique @map("token_hash")
  issuedAt     DateTime                  @map("issued_at")
  expiresAt    DateTime                  @map("expires_at")
  lastUsedAt   DateTime?                 @map("last_used_at")
  revokedAt    DateTime?                 @map("revoked_at")
  userAgent    String?                   @map("user_agent")
  ipAddress    String?                   @map("ip_address")
  revokeReason RefreshTokenRevokeReason? @map("revoke_reason")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model Challenge {
  id            String               @id @default(uuid()) @db.Uuid
  purpose       ChallengePurpose
  subjectType   ChallengeSubjectType @map("subject_type")
  subjectId     String?              @map("subject_id") @db.Uuid
  targetEmail   String?              @map("target_email")
  secretHash    String               @unique @map("secret_hash")
  status        ChallengeStatus      @default(REQUESTED)
  attempts      Int                  @default(0)
  maxAttempts   Int                  @map("max_attempts")
  metadata      Json
  expiresAt     DateTime             @map("expires_at")
  nextAttemptAt DateTime?            @map("next_attempt_at")
  consumedAt    DateTime?            @map("consumed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([subjectType, subjectId])
  @@index([status, expiresAt])
  @@index([purpose, targetEmail, createdAt])
  @@map("challenges")
}

model StoredFile {
  id              String            @id @default(uuid()) @db.Uuid
  ownerUserId     String            @map("owner_user_id") @db.Uuid
  contextType     StorageContextType @map("context_type")
  contextId       String            @map("context_id") @db.Uuid
  storageProvider StorageProvider   @map("storage_provider")
  storageKey      String            @db.VarChar(512) @map("storage_key")
  originalName    String?           @db.VarChar(255) @map("original_name")
  mimeType        String            @db.VarChar(100) @map("mime_type")
  sizeInBytes     Int               @map("size_in_bytes")
  checksum        String
  status          StorageStatus
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  owner           User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([storageProvider, storageKey])
  @@index([ownerUserId, status])
  @@map("stored_files")
}

model MessagingIdentity {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @map("user_id") @db.Uuid
  provider       MessagingProvider
  externalUserId String                  @map("external_user_id")
  conversationId String?                 @map("conversation_id")
  enabled        Boolean                 @default(false)
  status         MessagingIdentityStatus @default(PENDING_VERIFICATION)
  verifiedAt     DateTime?               @map("verified_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, externalUserId])
  @@index([userId, enabled, status])
  @@map("messaging_identities")
}
