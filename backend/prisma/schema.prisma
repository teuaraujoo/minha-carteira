generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model accounts {
  id              String        @id @db.Uuid
  user_id         String        @db.Uuid
  name            String        @db.VarChar(80)
  type            AccountType
  brand           String?       @db.VarChar(60)
  institution     String?       @db.VarChar(80)
  color           String?       @db.VarChar(7)
  initial_balance Decimal       @db.Decimal(14, 2)
  current_balance Decimal       @db.Decimal(14, 2)
  status          AccountStatus @default(ACTIVE)
  inactivated_at  DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, inactivated_at])
  @@index([user_id, status])
  @@index([user_id, type, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model challenges {
  id              String               @id @db.Uuid
  purpose         ChallengePurpose
  subject_type    ChallengeSubjectType
  subject_id      String?              @db.Uuid
  secret_hash     String               @unique
  status          ChallengeStatus      @default(REQUESTED)
  attempts        Int                  @default(0)
  max_attempts    Int
  metadata        Json
  expires_at      DateTime
  consumed_at     DateTime?
  created_at      DateTime             @default(now())
  updated_at      DateTime
  target_email    String?
  next_attempt_at DateTime?

  @@index([purpose, target_email, created_at])
  @@index([status, expires_at])
  @@index([subject_type, subject_id])
}

model refresh_tokens {
  id            String                    @id @db.Uuid
  user_id       String                    @db.Uuid
  token_hash    String                    @unique
  issued_at     DateTime
  expires_at    DateTime
  last_used_at  DateTime?
  revoked_at    DateTime?
  user_agent    String?
  ip_address    String?
  revoke_reason RefreshTokenRevokeReason?
  created_at    DateTime                  @default(now())
  updated_at    DateTime
  users         users                     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@index([user_id, revoked_at])
}

model stored_files {
  id               String             @id @db.Uuid
  owner_user_id    String             @db.Uuid
  context_type     StorageContextType
  context_id       String             @db.Uuid
  storage_provider StorageProvider
  storage_key      String             @db.VarChar(512)
  original_name    String?            @db.VarChar(255)
  mime_type        String             @db.VarChar(100)
  size_in_bytes    Int
  checksum         String
  status           StorageStatus
  created_at       DateTime           @default(now())
  updated_at       DateTime
  deleted_at       DateTime?
  users            users              @relation(fields: [owner_user_id], references: [id], onDelete: Cascade)

  @@unique([storage_provider, storage_key])
  @@index([owner_user_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id             String           @id @db.Uuid
  username       String           @unique
  name           String
  email          String           @unique
  phone          String
  role           UserRole         @default(USER)
  password_hash  String
  capabilities   UserCapability[] @default([])
  status         UserStatus       @default(ACTIVE)
  created_at     DateTime         @default(now())
  updated_at     DateTime
  inactivated_at DateTime?
  accounts       accounts[]
  refresh_tokens refresh_tokens[]
  stored_files   stored_files[]

  @@index([status, inactivated_at])
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  CHECKING
  CASH
  DIGITAL
  SAVINGS
  INVESTMENT
}

enum ChallengePurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  MESSAGING_IDENTITY_VERIFICATION
  ACCOUNT_REACTIVATION
}

enum ChallengeStatus {
  REQUESTED
  COMPLETED
  FAILED
  EXPIRED
}

enum ChallengeSubjectType {
  USER
  MESSAGING_IDENTITY
  EMAIL
}

enum RefreshTokenRevokeReason {
  LOGOUT
  PASSWORD_RESET
  USER_DEACTIVATED
  ADMINISTRATIVE_ACTION
  SECURITY_EVENT
}

enum StorageContextType {
  USER_PROFILE
  GROUP_COVER
  TRANSACTION_ATTACHMENT
  RECEIPT
}

enum StorageProvider {
  CLOUDFLARE_R2
}

enum StorageStatus {
  PROCESSING
  UPLOADING
  COMPLETED
  FAILED
}

enum UserCapability {
  TELEGRAM_TRANSACTIONS
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}
